# Maintainer: danyelsucio
pkgname=linux-samsung-gts7fewifi
pkgver=5.4.210
pkgrel=0
pkgdesc="Samsung Galaxy Tab S7 FE (SM-T733) kernel"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gts7fewifi"
url="https://postmarketos.org"
license="GPL-2.0-only"
options="!strip !check !archcheck"
makedepends="bash bc bison devicepkg-dev flex gcc gmp-dev libelf-dev mpc1-dev mpfr-dev openssl-dev perl python3"

source="config-samsung-gts7fewifi.aarch64
        kernel-5.4.patch"

prepare() {
    default_prepare
}

build() {
    # Generamos la configuración del kernel automáticamente si está vacía
    if [ ! -s "$srcdir/config-samsung-gts7fewifi.aarch64" ]; then
        echo "Generando configuración del kernel automáticamente..."
        make defconfig
        make menuconfig
    else
        echo "Usando configuración existente..."
        make olddefconfig
    fi
    
    # Compilamos el kernel (esto es lo que hace pmbootstrap realmente)
    make -j$(nproc) Image.gz dtbs
}

package() {
    # Copiamos el kernel compilado
    mkdir -p "$pkgdir"/boot
    cp "$builddir"/arch/arm64/boot/Image.gz "$pkgdir"/boot/
}

sha512sums="
SKIP
SKIP
"
