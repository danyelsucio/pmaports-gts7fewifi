# Maintainer: Your Name <you@example.com>
pkgname=linux-samsung-gts7fewifi
pkgver=5.4.210
pkgrel=0
pkgdesc="Samsung Galaxy Tab S7 FE (SM-T733) kernel"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gts7fewifi"
url="https://postmarketos.org"
license="GPL-2.0-only"
options="!strip !check !archcheck"
makedepends="bash bc bison devicepkg-dev flex gcc gmp-dev libelf-dev mpc1-dev mpfr-dev openssl-dev perl python3"

# Downstream kernel source from Samsung
source="
    https://github.com/danyelsucio/pmaports-gts7fewifi/raw/main/device/testing/linux-samsung-gts7fewifi/config-samsung-gts7fewifi.aarch64
    kernel-5.4.patch
"

prepare() {
    default_prepare
}

build() {
    # Usamos la herramienta de postmarketOS para generar el kernel
    pmbootstrap build linux-samsung-gts7fewifi
}

package() {
    # Copiamos el kernel compilado
    mkdir -p "$pkgdir"/boot
    cp "$builddir"/zImage "$pkgdir"/boot/
}

sha512sums="
SKIP
SKIP
"
